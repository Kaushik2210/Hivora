generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified Boolean        @default(false)
  passwordHash  String         @default("")
  githubId      String?        @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  tokens        RefreshToken[]
  auditLogs     AuditLog[]
  invitations   OrganizationInvitation[] @relation("InvitedBy")
  apiKeys       UserApiKey[]

  @@index([email])
}

model UserApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String   // 'anthropic', 'openai', 'cohere'
  keyValue  String   // stored as-is; encrypt at rest in production
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  family    String
  revoked   Boolean  @default(false)
  replacedBy String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}

enum UserRole {
  owner
  admin
  member
}

model Organization {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   Membership[]
  projects  Project[]
  subscriptions Subscription[]
  invitations OrganizationInvitation[]

  @@index([slug])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole     @default(member)
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id             String   @id @default(cuid())
  email          String
  organizationId String
  role           UserRole @default(member)
  token          String   @unique
  accepted       Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  invitedById    String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  path           String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]
  agents       Agent[]
  locks        Lock[]
  auditLogs    AuditLog[]

  @@index([organizationId])
}

enum TaskStatus {
  todo
  doing
  review_pending
  done
  conflict
}

enum TaskPriority {
  low
  medium
  high
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  assigneeId  String?
  duration    Int?
  cost        Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, assigneeId])
}

enum AgentType {
  ai
  human
}

enum AgentStatus {
  idle
  working
  offline
}

model Agent {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  type        AgentType
  status      AgentStatus @default(offline)
  provider    String?
  mode        String      @default("thinking")
  currentTask String?
  createdAt   DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model Lock {
  id        String   @id @default(cuid())
  projectId String
  file      String
  symbol    String
  agentId   String
  lockedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, file, symbol])
  @@index([projectId])
  @@index([projectId, agentId])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  projectId      String?
  action         String
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  user    User    ? @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
}

enum SubscriptionTier {
  free
  pro
  team
  enterprise
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier            SubscriptionTier  @default(free)
  status          SubscriptionStatus @default(active)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean          @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  usage           SubscriptionUsage?

  @@index([tier])
}

model SubscriptionUsage {
  id                    String       @id @default(cuid())
  subscriptionId        String       @unique
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  currentConcurrentAgents Int        @default(0)
  locksUsedToday        Int          @default(0)
  projectsInOrg         Int          @default(0)
  teamMembers           Int          @default(0)
  lastResetDate         DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([subscriptionId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
