# ──────────────────────────────────────────────────────────
# Hivora API — Production Environment Template
# Copy to .env.production and fill in all required values.
# NEVER commit .env.production to version control.
# ──────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000

# URLs
APP_URL=https://hivora.com
API_BASE_URL=https://api.hivora.com
COOKIE_DOMAIN=.hivora.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://hivora:CHANGE_ME@db.hivora.com:5432/hivora_prod

# Redis
REDIS_URL=redis://cache.hivora.com:6379

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_ME_MIN_64_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Email (Resend — https://resend.com)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=Hivora <noreply@hivora.com>
EMAIL_REPLY_TO=support@hivora.com

# CORS — comma-separated list
CORS_ORIGINS=https://hivora.com,https://www.hivora.com

# Monitoring (optional)
SENTRY_DSN=

# Billing (optional)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Providers (optional — not required for core functionality)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
