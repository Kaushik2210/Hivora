# ===== Hivora Environment =====
# Copy this file to .env and fill in your values.

# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# COOKIE_DOMAIN=  (leave blank for localhost)

# --- JWT ---
# Use a long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-super-secret-change-in-production-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Bcrypt ---
BCRYPT_ROUNDS=12

# --- Database (Neon / local Postgres) ---
# Neon:  postgresql://user:pass@ep-xxx.region.aws.neon.tech/hivora?sslmode=require
# Local: postgresql://postgres:postgres@localhost:5432/hivora
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hivora

# --- Redis (Upstash or local) ---
# Upstash: rediss://default:xxx@us1-xxx.upstash.io:6379
# Local:   redis://localhost:6379
# Leave blank to run in-memory (no queue/realtime-adapter/rate-limit-store)
REDIS_URL=

# --- Email ---
# console = print to terminal (dev), resend = Resend API
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=onboarding@resend.dev
EMAIL_REPLY_TO=support@hivora.local

# --- Billing (Stripe) — disabled by default ---
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Rate limiting ---
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
