{
  "name": "@hivora/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run rename:cjs && npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron dist-electron/main.cjs",
    "rename:cjs": "cd dist-electron && (Test-Path main.js) -and (Move-Item -Path main.js -Destination main.cjs -Force) || true",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json && electron-builder",
    "build:win": "npm run build -- --win",
    "build:mac": "npm run build -- --mac",
    "build:linux": "npm run build -- --linux",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@hivora/shared": "*",
    "@hivora/ui": "*",
    "@dnd-kit/core": "^6.1.0",
    "lucide-react": "^0.344.0",
    "sonner": "^1.4.0",
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.12.0",
    "typescript": "^5.4.5",
    "vite": "^5.1.0"
  },
  "build": {
    "appId": "com.hivora.app",
    "productName": "Hivora",
    "copyright": "Copyright © 2024 Hivora",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "hivora",
      "repo": "hivora"
    }
  }
}
