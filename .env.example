# Example environment variables for local development
# Copy to .env and fill values

# Core
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
COOKIE_DOMAIN=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hivora

# Redis for queues/sessions
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Email provider (Resend)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=no-reply@hivora.local
EMAIL_REPLY_TO=support@hivora.local

# JWT / auth
JWT_SECRET=dev-super-secret-change-in-production-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
BCRYPT_ROUNDS=12

# AI Providers
AI_PROVIDERS=openai,anthropic,cohere
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-1
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# Billing / Stripe (optional)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate Limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120

# Monitoring (optional)
SENTRY_DSN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
